[sub_resource type="GDScript" id="GDScript_a2dpt"]
script/source = "extends Control

var categories : Dictionary
var topCategories
var sideCategories
func _ready():
	var children = get_children()
	for c in children:
		categories[c.name] = c
	var cats = PokemonData.select_categories()
	topCategories = cats[0]
	sideCategories = cats[1]
	PokemonData.verify_categories(topCategories,sideCategories)
	update_categories()
	
func update_categories():
	for x in range(65,68):
		categories[char(x)].change_category(topCategories[x-65].target)
	for x in range(1,4):
		categories[str(x)].change_category(sideCategories[x-1].target)






func _on_texture_button_pressed():
	var cats = PokemonData.select_categories()
	topCategories = cats[0]
	sideCategories = cats[1]
	PokemonData.verify_categories(topCategories,sideCategories)
	update_categories()
"

