[sub_resource type="GDScript" id="GDScript_a2dpt"]
script/source = "extends Control

var categories : Dictionary
var selectedCats = []
func _ready():
	var children = get_children()
	for c in children:
		categories[c.name] = c
	select_categories_new()


func select_categories_new():
	var cat = PokemonData.random_category(true)
	var pokemon = PokemonData.random_pokemon()


func select_categories():
	var random = RandomNumberGenerator.new()
	var topAnswers = []
	var topCats = []
	var sideCats = []
	for x in range(0,3):
		while true:
			var cat = PokemonData.random_category(true)
			var answer = PokemonData.random_category_answer(cat)
			var pokemon = PokemonData.get_valid_pokemon([[cat,answer]])
			if len(pokemon) < 3:
				assert(\"not enough pokemon in first category\")
			if answer not in topAnswers:
				topAnswers.append(answer)
				topCats.append(cat)
				break
		categories[str(x+1)].change_category(topAnswers[x])
	var selectedPokemon = []
	
	var checkPassed = false
	while checkPassed == false:
		selectedPokemon.clear()
		var Pokemon1A = PokemonData.random_pokemon([[topCats[0],topAnswers[0]]],[\"*\"], 1)
		var newCat = PokemonData.random_category(false, [topCats[0]]) #Okayable null?
		var newAnswer = Pokemon1A[newCat]
		selectedPokemon.append(Pokemon1A)
		if Pokemon1A[newCat] == topAnswers[0][0]:
			continue
		if newAnswer == null:
			continue
		print(\"Check 1 passed\")
		for x in range(1,3):
			var flagPokemon = PokemonData.random_pokemon([[topCats[x],topAnswers[x]],[newCat,newAnswer]],[\"*\"], 1)
			if flagPokemon == null:
				break
			else:
				selectedPokemon.append(flagPokemon)
				print(\"Check %s passed\" % [str(x)])
		if len(selectedPokemon) == 3:
			break
	print(selectedPokemon)

	#for x in range(1,4):
	#	var catAnswers = PokemonData.currentCategoryAnswers[topCats[x-1]]
	#	var answer = catAnswers[random.randi_range(0,len(catAnswers))]
	#	categories[str(x)].change_category(answer)
	#for x in range(65,68):
	#	categories[char(x)].change_category(sideCats[x-65])
"

